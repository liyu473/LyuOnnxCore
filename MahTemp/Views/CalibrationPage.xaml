<UserControl
    x:Class="MahTemp.Views.CalibrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:MahTemp.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:CalibrationViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource MahApps.Styles.MetroHeader.Horizontal}" TargetType="mah:MetroHeader" />
        <Style BasedOn="{StaticResource MahApps.Styles.Button.Flat}" TargetType="Button" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标定参数配置  -->
        <Border
            Grid.Row="0"
            Padding="15"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="标定板参数" />

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <WrapPanel>
                        <mah:MetroHeader Margin="0,0,15,0" Header="内角点列数">
                            <mah:NumericUpDown
                                Width="100"
                                Minimum="2"
                                Value="{Binding InnerCornerColumns}" />
                        </mah:MetroHeader>

                        <mah:MetroHeader Margin="0,0,15,0" Header="内角点行数">
                            <mah:NumericUpDown
                                Width="100"
                                Minimum="2"
                                Value="{Binding InnerCornerRows}" />
                        </mah:MetroHeader>

                        <mah:MetroHeader Margin="0,0,15,0" Header="方格尺寸(mm)">
                            <mah:NumericUpDown
                                Width="100"
                                Interval="0.1"
                                Minimum="0.1"
                                StringFormat="F1"
                                Value="{Binding SquareSize}" />
                        </mah:MetroHeader>

                        <Button
                            Margin="0,20,0,0"
                            Padding="15,8"
                            Command="{Binding LoadCalibrationImagesCommand}"
                            Content="加载标定图片" />

                        <Button
                            Margin="10,20,0,0"
                            Padding="15,8"
                            Command="{Binding StartCalibrationCommand}"
                            Content="开始标定"
                            IsEnabled="{Binding CanCalibrate}" />

                        <Button
                            Margin="10,20,0,0"
                            Padding="15,8"
                            Command="{Binding SaveCalibrationResultCommand}"
                            Content="保存标定结果"
                            IsEnabled="{Binding HasCalibrationResult}" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  图片列表和预览  -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!--  左侧：图片列表  -->
            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding ImageListHeader}" />

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding CalibrationImages}"
                        SelectedItem="{Binding SelectedImage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        Foreground="Green"
                                        Text="✓"
                                        Visibility="{Binding IsDetected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!--  中间：图片预览  -->
            <Border
                Grid.Column="1"
                Margin="12,0"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />

                    <!--  标定进度  -->
                    <Grid Visibility="{Binding IsCalibrating, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.Background>
                            <SolidColorBrush Opacity="0.7" Color="Black" />
                        </Grid.Background>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <mah:ProgressRing
                                Width="60"
                                Height="60"
                                IsActive="{Binding IsCalibrating}" />
                            <TextBlock
                                Margin="0,15,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                Foreground="White"
                                Text="正在标定中..." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!--  右侧：标定结果  -->
            <Border
                Grid.Column="2"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="1"
                CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="标定结果" />

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasCalibrationResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="图像尺寸：" />
                            <TextBlock
                                Margin="5,2,0,0"
                                Foreground="Gray"
                                Text="{Binding ImageSizeText}" />

                            <TextBlock Margin="0,10,0,0" Text="重投影误差：" />
                            <TextBlock
                                Margin="5,2,0,0"
                                Foreground="Gray"
                                Text="{Binding ReprojectionErrorText}" />

                            <TextBlock Margin="0,10,0,0" Text="成功标定图片数：" />
                            <TextBlock
                                Margin="5,2,0,0"
                                Foreground="Gray"
                                Text="{Binding SuccessfulImageCountText}" />

                            <TextBlock Margin="0,10,0,0" Text="相机矩阵：" />
                            <TextBox
                                Margin="5,2,0,0"
                                IsReadOnly="True"
                                Text="{Binding CameraMatrixText, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock Margin="0,10,0,0" Text="畸变系数：" />
                            <TextBox
                                Margin="5,2,0,0"
                                IsReadOnly="True"
                                Text="{Binding DistortionCoefficientsText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,20,0,0"
                            Foreground="Gray"
                            Text="请加载标定图片并开始标定"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasCalibrationResult, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  底部：提示信息  -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="10"
            Background="#FFF9F3"
            BorderBrush="#FFE0C0"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock FontSize="12" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="💡 使用说明：" />
                <LineBreak />
                <Run Text="1. 配置标定板参数（内角点行列数、方格尺寸）" />
                <LineBreak />
                <Run Text="2. 加载多张不同角度拍摄的标定板图片（至少3张，建议10-20张）" />
                <LineBreak />
                <Run Text="3. 点击开始标定进行相机标定" />
                <LineBreak />
                <Run Text="4. 标定完成后可保存结果供后续使用" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
