<UserControl
    x:Class="MahTemp.Views.DetectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:MahTemp.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:DetectionViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource MahApps.Styles.MetroHeader.Horizontal}" TargetType="mah:MetroHeader" />
        <Style BasedOn="{StaticResource MahApps.Styles.Button.Flat}" TargetType="Button" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="14"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="0.5"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <mah:MetroHeader Margin="0,0,12,0" Header="Detector">
                        <ComboBox
                            Width="180"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding DetectionModes}"
                            SelectedItem="{Binding SelectedDetectionMode}" />
                    </mah:MetroHeader>

                    <mah:MetroHeader Margin="0,0,12,0" Header="Model">
                        <ComboBox
                            Width="240"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding OnnxSources}"
                            SelectedItem="{Binding SelectedOnnxModel}" />
                    </mah:MetroHeader>

                    <mah:MetroHeader Margin="0,0,12,0" Header="Labels">
                        <mah:MultiSelectionComboBox
                            MinWidth="220"
                            mah:MultiSelectorHelper.SelectedItems="{Binding SelelctedLabels}"
                            mah:TextBoxHelper.AutoWatermark="True"
                            mah:TextBoxHelper.UseFloatingWatermark="True"
                            ItemsSource="{Binding LabesSource}"
                            SelectedItemContainerStyle="{StaticResource MahApps.Styles.MultiSelectionComboBoxSelectedItem.Removable}" />
                    </mah:MetroHeader>

                    <Button
                        Margin="0,26,10,0"
                        Command="{Binding RefreshModelsCommand}"
                        Content="Refresh Models" />

                    <mah:DropDownButton
                        Margin="0,26,0,0"
                        Padding="10,5"
                        Content="Load Labels">
                        <mah:DropDownButton.ItemsSource>
                            <x:Array Type="{x:Type MenuItem}">
                                <MenuItem Command="{Binding LoadLabesFromFileCommand}" Header="From File" />
                            </x:Array>
                        </mah:DropDownButton.ItemsSource>
                    </mah:DropDownButton>
                </WrapPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedDetectionMode.Description, TargetNullValue=Select a detector to begin.}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="Gray"
                        Text="{Binding SelectedOnnxModel.FullPath, TargetNullValue=No ONNX model found under OnnxModel.}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <mah:SplitView
            x:Name="OptionsSplitView"
            Grid.Row="1"
            Margin="0,12,0,0"
            DisplayMode="Overlay"
            IsPaneOpen="False"
            PanePlacement="Right">

            <mah:SplitView.Pane>
                <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Detection Options" />
                        </StackPanel>

                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <mah:MetroHeader Header="Confidence">
                                    <mah:NumericUpDown
                                        Interval="0.01"
                                        Maximum="1"
                                        Minimum="0.01"
                                        StringFormat="F2"
                                        Value="{Binding ConfidenceThreshold}" />
                                </mah:MetroHeader>

                                <mah:MetroHeader Margin="0,10,0,0" Header="NMS">
                                    <mah:NumericUpDown
                                        Interval="0.01"
                                        Maximum="1"
                                        Minimum="0.01"
                                        StringFormat="F2"
                                        Value="{Binding NmsThreshold}" />
                                </mah:MetroHeader>

                                <mah:MetroHeader Margin="0,10,0,0" Header="Box Thickness">
                                    <mah:NumericUpDown
                                        Interval="1"
                                        Maximum="10"
                                        Minimum="1"
                                        Value="{Binding BoxThickness}" />
                                </mah:MetroHeader>

                                <mah:MetroHeader Margin="0,10,0,0" Header="Font Scale">
                                    <mah:NumericUpDown
                                        Interval="0.1"
                                        Maximum="3"
                                        Minimum="0.3"
                                        StringFormat="F1"
                                        Value="{Binding FontScale}" />
                                </mah:MetroHeader>

                                <mah:ToggleSwitch
                                    Margin="0,14,0,0"
                                    Content="Show Label"
                                    IsOn="{Binding ShowLabel}" />

                                <mah:ToggleSwitch
                                    Margin="0,10,0,0"
                                    Content="Show Confidence"
                                    IsOn="{Binding ShowConfidence}" />

                                <mah:MetroHeader Margin="0,14,0,0" Header="Box Color">
                                    <mah:ColorPicker SelectedColor="{Binding BoxColor}" />
                                </mah:MetroHeader>

                                <mah:MetroHeader Margin="0,10,0,0" Header="Text Color">
                                    <mah:ColorPicker SelectedColor="{Binding TextColor}" />
                                </mah:MetroHeader>

                                <Separator Margin="0,16,0,12" />

                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Overlay Filtering" />

                                <mah:ToggleSwitch
                                    Margin="0,10,0,0"
                                    Content="Enable Overlay Filter"
                                    IsOn="{Binding IsFilterOverlay}" />

                                <mah:ToggleSwitch
                                    Margin="0,10,0,0"
                                    Content="Cross Class Filter"
                                    IsEnabled="{Binding IsFilterOverlay}"
                                    IsOn="{Binding IsCrossClass}" />

                                <mah:MetroHeader
                                    Margin="0,10,0,0"
                                    Header="Overlay Threshold"
                                    IsEnabled="{Binding IsFilterOverlay}">
                                    <mah:NumericUpDown
                                        Interval="0.05"
                                        Maximum="1"
                                        Minimum="0.1"
                                        StringFormat="F2"
                                        Value="{Binding OverlayThreshold}" />
                                </mah:MetroHeader>

                                <Border
                                    Margin="0,10,0,0"
                                    Padding="10"
                                    Background="#FFF9F3"
                                    BorderBrush="#FFE0C0"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock Foreground="#884E22" TextWrapping="Wrap">
                                        Lower values keep fewer overlapping boxes. Around 0.8 is a good default for most YOLOX models.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </mah:SplitView.Pane>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Row="0" Grid.ColumnSpan="2" LastChildFill="False">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding LoadImageCommand}"
                            Content="Load Image" />
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding StartDetectionCommand}"
                            Content="Run Detection" />
                        <Button Content="Options">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:ChangePropertyAction
                                        PropertyName="IsPaneOpen"
                                        TargetObject="{Binding ElementName=OptionsSplitView}"
                                        Value="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        Text="{Binding ImagePath, TargetNullValue=Load an image to start testing your YOLOX model.}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,12,8,12"
                    BorderBrush="{StaticResource MahApps.Brushes.Accent}"
                    BorderThickness="0.5"
                    CornerRadius="8">
                    <Grid>
                        <Image Source="{Binding OriginalImage}" Stretch="Uniform" />
                        <TextBlock
                            Margin="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Padding="8,4"
                            Background="#AA000000"
                            Foreground="White"
                            Text="Original" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,12,0,12"
                    BorderBrush="{StaticResource MahApps.Brushes.Accent}"
                    BorderThickness="0.5"
                    CornerRadius="8">
                    <Grid>
                        <Image Source="{Binding ResultImage}" Stretch="Uniform" />

                        <TextBlock
                            Margin="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Padding="8,4"
                            Background="#AA000000"
                            Foreground="White"
                            Text="Result" />

                        <Grid Visibility="{Binding IsDetecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.Background>
                                <SolidColorBrush Opacity="0.7" Color="Black" />
                            </Grid.Background>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <mah:ProgressRing
                                    Width="60"
                                    Height="60"
                                    IsActive="{Binding IsDetecting}" />
                                <TextBlock
                                    Margin="0,15,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Foreground="White"
                                    Text="Running detection..." />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DetectionTime, TargetNullValue=Ready.}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="Gray"
                            Text="{Binding DetectionSummary, TargetNullValue=Select a model and image before running YOLOX detection.}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="6,0,0,0"
                            Command="{Binding SaveCroppedRegionsCommand}"
                            Content="Save Crops" />
                        <Button
                            Margin="6,0,0,0"
                            Command="{Binding SaveDetectionResultCommand}"
                            Content="Save Result" />
                    </StackPanel>
                </Grid>
            </Grid>
        </mah:SplitView>
    </Grid>
</UserControl>
